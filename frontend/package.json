{
  "name": "gpupanel-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "GPUPanel 前端（React 19 + shadcn/ui + Tailwind + Redux Toolkit），Docker Desktop 同款技术栈",
  "scripts": {
    "dev": "pnpm --filter @gpupanel/panel dev",
    "build": "pnpm --filter @gpupanel/panel build",
    "preview": "pnpm --filter @gpupanel/panel preview",
    "typecheck": "pnpm --filter @gpupanel/panel typecheck",
    "clean": "rm -rf apps/*/node_modules node_modules apps/*/dist",
    "test": "pnpm --filter @gpupanel/panel test"
  },
  "packageManager": "pnpm@12.8.1"
}
